{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test/integration"],
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@halo/shared(.*)$": "<rootDir>/../../packages/shared/src$1"
  },
  "testTimeout": 60000,
  "maxWorkers": 1
}
