# ── Core ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://halo:halo_dev_password@localhost:5432/halo_dev?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001
NODE_ENV="development"

# ── Authentication (Descope) ──────────────────────────────────────
DESCOPE_PROJECT_ID="your-descope-project-id"
DESCOPE_MANAGEMENT_KEY=""

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"

# ── Encryption ────────────────────────────────────────────────────
# 64-char hex string — REQUIRED in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=""

# ── Webhook Verification ─────────────────────────────────────────
# Required if accepting Twilio/DocuSign webhooks
TWILIO_AUTH_TOKEN=""
DOCUSIGN_CONNECT_SECRET=""

# ── External Data Integrations ───────────────────────────────────
ATTOM_API_KEY=""
ATTOM_BASE_URL="https://api.gateway.attomdata.com"
GOOGLE_GEOCODING_API_KEY=""
RENTCAST_API_KEY=""
REALIE_API_KEY=""

# ── Object Storage (S3 / MinIO) ─────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="halo-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ── DocuSign ─────────────────────────────────────────────────────
# JWT grant: integration key, impersonated API user, account, RSA private key (PEM; literal \n allowed)
# Usually set on the Integrations page instead. docs/integrations/docusign.md
DOCUSIGN_CLIENT_ID=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_RSA_PRIVATE_KEY=""
DOCUSIGN_ENV="demo"
DOCUSIGN_BASE_URL=""

# ── Messaging compliance (docs/messaging-compliance.md) ──────────
# Email is refused until PUBLIC_API_URL, EMAIL_FROM and EMAIL_POSTAL_ADDRESS
# are set: every email carries an unsubscribe link and a postal address.
PUBLIC_API_URL="http://localhost:3001/api"
EMAIL_FROM=""
EMAIL_POSTAL_ADDRESS=""
# Used in STOP / HELP replies and the unsubscribe page.
MESSAGING_BRAND_NAME=""
MESSAGING_HELP_CONTACT=""
# app: the api answers STOP / HELP. provider: Twilio Advanced Opt-Out does.
SMS_KEYWORD_REPLIES="app"

# ── Contact PII at rest (required; docs/pii-encryption-design.md) ──
# Generate each with: openssl rand -hex 32
# Losing PII_ENCRYPTION_KEY_V1 loses every encrypted phone/email.
PII_ENCRYPTION_KEY_V1=
PII_ENCRYPTION_KEY_CURRENT_VERSION=1
PII_INDEX_KEY=

# ── Model providers (the api routes by model name: gpt-* -> OpenAI, claude-* -> Anthropic) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for organization-level keys (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=""

# ── MLS listings feed (docs/integrations/mls.md) ──
# bridge: Bridge Data Output, one dataset per MLS (needs that MLS's approval of your account)
# reso:   any other RESO Web API endpoint with a bearer token (MLS Grid, Trestle, Spark)
# simplyrets: SimplyRETS; the public demo feed is simplyrets/simplyrets
MLS_PROVIDER=
MLS_BASE_URL=
MLS_DATASET=
MLS_API_TOKEN=
MLS_USERNAME=
MLS_PASSWORD=

# Sourcing scheduler (docs/sourcing-markets.md): pulls every enabled market on its cadence
SOURCING_SCHEDULER=on
SOURCING_RUN_HOUR_UTC=6
# Agent sweep (docs/agent-design.md s4): nightly re-queue of leads stale in `enriched`
AGENT_SWEEP=on
AGENT_SWEEP_HOUR_UTC=7
AGENT_SWEEP_STALE_DAYS=7
# Outreach Drafter: follow up after N quiet days, at most M times; strong model tier above this ARV
AGENT_FOLLOWUP_DAYS=3
AGENT_FOLLOWUP_MAX=3
OUTREACH_STRONG_TIER_MIN_ARV=400000
# Disposition Matcher: buyers sent to the model, and the most it may shortlist
AGENT_MATCHER_CANDIDATES=15
AGENT_MATCHER_SHORTLIST_MAX=10
