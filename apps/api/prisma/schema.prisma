// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum JobRunKind {
  UNDERWRITE_DEAL
  GENERATE_FLYER_DRAFT
  GENERATE_BUYER_BLAST_DRAFT
  GENERATE_VIDEO_SCRIPT
}

enum JobRunEntityType {
  DEAL
  LEAD
  MESSAGE
}

enum JobRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum TimelineEntityType {
  LEAD
  DEAL
  MESSAGE
  PROPERTY
  JOB
  BUYER
}

enum TimelineActorType {
  user
  system
  webhook
}

// =============================================================================
// LEGACY: pre-Descope multi-tenant + RBAC models
// =============================================================================
// These models predate the Descope-based auth flow that the runtime
// services use today (see apps/api/src/auth/). They're retained for
// historical / data-export purposes only - no controller, service, or
// guard reads or writes them at runtime. Deletion is tracked as a
// follow-up after a 60-day data retention window.
//
//   Account, User, Membership, Role, Permission, RolePermission,
//   MembershipRole, Session, JobQueue
//
// New code MUST NOT add foreign keys or indexes against these tables.
// The active tenant identifier is `accountId` (a string column on
// Lead/Property/Deal/etc.) populated from the Descope session claims.

// Multi-tenant support
model Account {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@map("accounts")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Membership {
  id        String   @id @default(cuid())
  accountId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles   MembershipRole[]

  @@unique([accountId, userId])
  @@map("memberships")
}

// RBAC
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  memberships MembershipRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String   @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

// NextAuth sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Leads
model Lead {
  id        String   @id @default(cuid())
  accountId String
  status    String   @default("new") // new, enriched, underwriting, contacted, etc.
  score     Float?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Canonical fields (reconciled)
  canonicalAddress   String?
  canonicalCity      String?
  canonicalState     String?
  canonicalZip       String?
  canonicalOwner     String?
  // Contact PII is stored encrypted (pii-envelope JSON) with a blind-index
  // hash for exact-match lookups; there is no plaintext column. Reads go
  // through lead-pii.ts (reveal / present). See docs/pii-encryption-design.md.
  canonicalPhoneEnc  String?
  canonicalEmailEnc  String?
  canonicalPhoneHash String?
  canonicalEmailHash String?

  // Source provenance
  sourceRecords SourceRecord[]
  properties    Property[]
  deals         Deal[]
  consents      Consent[]

  @@index([status])
  @@index([accountId, createdAt])
  @@index([accountId, status, createdAt])
  @@index([canonicalAddress(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_canonicalAddress_trgm_idx")
  @@index([canonicalOwner(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_canonicalOwner_trgm_idx")
  @@index([accountId, canonicalPhoneHash])
  @@index([accountId, canonicalEmailHash])
  @@map("leads")
}

// Source records (provenance)
model SourceRecord {
  id          String   @id @default(cuid())
  leadId      String?
  propertyId  String?
  provider    String // attom, google, etc.
  endpoint    String
  requestHash String
  response    Json
  trustWeight Float    @default(1.0)
  createdAt   DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([propertyId])
  @@index([provider])
  @@index([provider, requestHash, createdAt])
  @@map("source_records")
}

// Properties (canonical)
model Property {
  id             String    @id @default(cuid())
  leadId         String?
  accountId      String
  apn            String?
  address        String
  city           String
  state          String
  zip            String
  latitude       Float?
  longitude      Float?
  estimatedValue Float?
  /// Seller asking / agreed sale price (vs estimatedValue for spread)
  salePrice      Float?
  confidence     Float     @default(1.0)
  /// Facts from property-data providers (docs/data-pipeline.md s2).
  county         String?
  countyFips     String?
  propertyType   String?
  beds           Float?
  baths          Float?
  sqft           Float?
  lotSqft        Float?
  yearBuilt      Int?
  assessedValue  Float?
  lastSaleDate   DateTime?
  lastSalePrice  Float?
  /// company | trust | individual | lender | government
  ownerKind      String?
  absentee       Boolean?
  /// Which provider the facts came from, its id for the parcel, and how far to trust them.
  dataSource     String?
  dataSourceRef  String?
  /// recorded | reported | estimated
  dataQuality    String?
  dataUpdatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead                Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sourceRecords       SourceRecord[]
  deals               Deal[]
  underwritingResults UnderwritingResult[]

  @@index([apn])
  @@index([address, city, state, zip])
  @@index([leadId])
  @@index([accountId, createdAt])
  @@index([latitude, longitude])
  @@index([accountId, countyFips])
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_address_trgm_idx")
  @@map("properties")
}

// Deals
model Deal {
  id              String   @id @default(cuid())
  accountId       String
  leadId          String?
  propertyId      String?
  stage           String   @default("new") // new, contacted, negotiating, under_contract, marketing, assigned, closed, lost
  arv             Float?
  repairEstimate  Float?
  mao             Float?
  offerAmount     Float?
  /// standard | tax_sale. A tax-sale deal is marketed only once the interest
  /// it acquired is verified (tax_sale_interests).
  acquisitionType String   @default("standard")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lead                 Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property             Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  contracts            Contract[]
  underwritingResult   UnderwritingResult?
  marketingMaterials   MarketingMaterial[]
  economics            DealEconomics?
  purchaseAgreements   PurchaseAgreement[]
  dealPackages         DealPackage[]
  dispositionCampaigns DispositionCampaign[]
  shareLinks           DealShareLink[]
  buyerOffers          BuyerOffer[]
  assignmentAgreements AssignmentAgreement[]
  closingFile          ClosingFile?
  taxSaleInterest      TaxSaleInterest?

  @@index([stage])
  @@index([leadId])
  @@index([propertyId])
  @@index([accountId, createdAt])
  @@index([accountId, stage, createdAt])
  @@map("deals")
}

// Contracts (DocuSign)
model Contract {
  id                 String   @id @default(cuid())
  dealId             String
  docusignEnvelopeId String?  @unique
  status             String // draft, sent, delivered, completed, declined, voided
  /// What the envelope is: purchase_agreement (with the seller), assignment
  /// (with the cash buyer) or other. Null on envelopes sent before it existed.
  purpose            String?
  pdfUrl             String?
  /// What was sent and to whom (roles only, never addresses): documents, recipients, subject, signed copy.
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([docusignEnvelopeId])
  @@map("contracts")
}

// Communications
model Message {
  id               String    @id @default(cuid())
  accountId        String
  leadId           String?
  dealId           String?
  channel          String // sms, email
  direction        String // inbound, outbound
  status           String // draft, pending_approval, approved, sent, delivered, failed
  content          String
  metadata         Json?
  // External party (recipient if outbound, sender if inbound), encrypted
  // with a blind index. See communications/message-counterparty.ts.
  counterpartyEnc  String?
  counterpartyHash String?
  approvedAt       DateTime?
  approvedBy       String?
  sentAt           DateTime?
  source           String? // e.g. "agent", "user", "system"
  automationRunId  String?
  agentName        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  automationRun AutomationRun? @relation("AutomationRunMessages", fields: [automationRunId], references: [id])

  @@index([leadId])
  @@index([status])
  @@index([automationRunId])
  @@index([dealId])
  @@index([accountId, status, createdAt])
  @@index([accountId, source, status, createdAt])
  @@index([accountId, counterpartyHash])
  @@map("messages")
}

// Buyers
model Buyer {
  id              String    @id @default(cuid())
  accountId       String
  name            String
  // Contact PII: envelope ciphertext + blind index, no plaintext column, as
  // on leads. Reads go through buyers/buyer-pii.ts (mask) or PIIService.
  emailEnc        String?
  emailHash       String?
  phoneEnc        String?
  phoneHash       String?
  /// Stated buy box: locations, priceRange {min,max}, propertyTypes,
  /// maxRepairEstimate, minARV, strategies. What the buyer told us, not
  /// evidence of what they buy (that is buyer_transactions).
  preferences     Json?
  engagementScore Float     @default(0.0)
  lastContacted   DateTime?
  company         String?
  /// active | inactive | do_not_market
  status          String    @default("active")
  /// Where the record came from: manual | import | inbound_inquiry |
  /// deal_page | referral | public_record, with a free-text detail.
  source          String    @default("manual")
  sourceDetail    String?
  /// cash | hard_money | private_money | conventional | unknown
  fundingType     String    @default("unknown")
  /// Proof of funds: none | requested | received | verified | expired | rejected.
  /// Only `verified` (a person checked the document) counts as proof.
  pofStatus       String    @default("none")
  pofAmount       Float?
  pofDocumentId   String?
  pofVerifiedAt   DateTime?
  pofVerifiedBy   String?
  pofExpiresAt    DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions BuyerTransaction[]
  offers       BuyerOffer[]
  targets      DispositionTarget[]

  @@index([accountId, status])
  @@index([accountId, engagementScore])
  @@index([accountId, emailHash])
  @@index([accountId, phoneHash])
  @@map("buyers")
}

// Control plane
model ControlPlane {
  id                        String   @id @default(cuid())
  /// Owning tenant. The reserved value "GLOBAL" is a platform-wide master
  /// switch: a flag is only on if BOTH the tenant row and the GLOBAL row
  /// (when present) allow it, and the effective cap is the lower of the two.
  /// Before this column existed there was a single unscoped row, so one
  /// tenant flipping a switch changed behaviour for every tenant.
  accountId                 String
  enabled                   Boolean  @default(true)
  /// Channel switches. New tenants start with both off: external messages
  /// need an explicit decision (docs/communications.md s2).
  smsEnabled                Boolean  @default(false)
  emailEnabled              Boolean  @default(false)
  /// Marketing (campaigns, blasts, first approaches) needs its own switch on
  /// top of the channel's, so enabling deal paperwork never enables campaigns.
  marketingEmailEnabled     Boolean  @default(false)
  marketingSmsEnabled       Boolean  @default(false)
  docusignEnabled           Boolean  @default(true)
  externalDataEnabled       Boolean  @default(true)
  aiDailyCostCap            Float    @default(2.0)
  apiDailyCostCap           Float    @default(50)
  aiEnabled                 Boolean  @default(true)
  /// Agent autonomy tier (docs/agent-design.md s5): draft_only keeps every
  /// agent action approval-gated; standard lets agents apply the autonomous
  /// tier (scores, notes, hard-rule disqualifies) on their own.
  agentAutonomy             String   @default("draft_only")
  /// Model per tier, e.g. {"cheap":"gpt-4o-mini","mid":"gpt-4o","strong":"claude-opus-5-5"}; null = platform default.
  agentModels               Json?
  /// New leads moved to enriching automatically, up to autoEnrichDailyCap per UTC day.
  autoEnrichEnabled         Boolean  @default(true)
  autoEnrichDailyCap        Int      @default(20)
  /// Wholesale fee in dollars: added to the seller price to get the buyers'
  /// price, subtracted in the Underwriter's MAO. A deal's own fee
  /// (deal_economics.assignmentFee) overrides it.
  defaultAssignmentFee      Int      @default(10000)
  /// Contract flipping (docs/contract-flipping.md). The least net profit a
  /// deal may be assigned for; offers below it are recommended for rejection.
  minNetProfit              Int      @default(5000)
  /// Our typical costs paid out of the fee, used when a deal records none.
  dispositionCosts          Int      @default(0)
  /// Below this underwriting confidence the ARV is shown to buyers as unconfirmed.
  minUnderwritingConfidence Float    @default(0.5)
  /// A buyer's proof of funds must be verified before an offer is accepted.
  requireVerifiedPof        Boolean  @default(true)
  /// on_funds_received | on_closing_confirmed
  revenueRecognition        String   @default("on_funds_received")
  campaignFollowUpDays      Int      @default(3)
  campaignMaxFollowUps      Int      @default(2)
  /// Marketing texts are scrubbed against the Do Not Call registry data on
  /// file (docs/communications.md s7). On until a person turns it off with
  /// counsel's answer: an unknown obligation never permits.
  dncRegistryRequired       Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?

  @@unique([accountId])
  @@map("control_plane")
}

// Integration secrets — keys are AES-256-GCM encrypted at rest
model IntegrationSecret {
  id             String   @id @default(cuid())
  provider       String // e.g. "twilio", "docusign", "attom", "openai"
  keyName        String // e.g. "TWILIO_ACCOUNT_SID", "TWILIO_AUTH_TOKEN"
  encryptedValue String // AES-256-GCM ciphertext (base64)
  iv             String // initialization vector (base64)
  tag            String // auth tag (base64)
  maskedHint     String // last 4 chars for UI display, e.g. "••••a1b2"
  setBy          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, keyName])
  @@map("integration_secrets")
}

// Compliance: DNC (do not contact) list. An entry names a phone, an email or
// both, and suppresses every channel to that contact. accountId is the
// tenant, or "GLOBAL" for an opt-out no tenant could be matched to (read by
// every tenant's check). Contacts are ciphertext + blind index only; the
// migration adds CHECK ("phoneHash" IS NOT NULL OR "emailHash" IS NOT NULL).
model DNCList {
  id        String    @id @default(cuid())
  accountId String
  phoneEnc  String?
  phoneHash String?
  emailEnc  String?
  emailHash String?
  source    String // manual, stop_keyword, unsubscribe_link, external
  reason    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime? // null = permanent

  @@unique([accountId, phoneHash])
  @@unique([accountId, emailHash])
  @@index([accountId])
  @@map("dnc_list")
}

// Compliance: Do Not Call registry data (docs/communications.md s7). One
// row per import of the National Do Not Call Registry, or a state list,
// for the area codes the account subscribed to; the numbers on it below.
model DncRegistryList {
  id          String   @id @default(cuid())
  accountId   String
  /// "national", or a state code for a state's own list.
  source      String
  /// Three-digit area codes the download covers, listed numbers or not.
  areaCodes   String[]
  /// When the data was downloaded from the registry. Coverage lapses 31
  /// days after it (the Telemarketing Sales Rule safe harbor).
  fetchedAt   DateTime
  numberCount Int      @default(0)
  skipped     Int      @default(0)
  fileName    String?
  importedAt  DateTime @default(now())
  importedBy  String?

  numbers DncRegistryNumber[]

  @@index([accountId, source])
  @@map("dnc_registry_lists")
}

/// A ten-digit US number on a registry list. Matched against the
/// recipient's number at send time; kept only for that purpose.
model DncRegistryNumber {
  listId String
  phone  BigInt

  list DncRegistryList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([listId, phone])
  @@index([phone])
  @@map("dnc_registry_numbers")
}

// Compliance: Consent records
model Consent {
  id        String    @id @default(cuid())
  accountId String
  leadId    String?
  // Contact PII: ciphertext + blind index only (see DNCList).
  phoneEnc  String?
  phoneHash String?
  emailEnc  String?
  emailHash String?
  channel   String // sms, email, call
  source    String // manual, form, verbal, implied
  evidence  Json? // proof/documentation
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  expiresAt DateTime?

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([leadId])
  @@index([accountId, phoneHash])
  @@index([accountId, emailHash])
  @@map("consents")
}

// Compliance: Quiet hours configuration
model QuietHours {
  id        String   @id @default(cuid())
  accountId String
  timezone  String   @default("America/Los_Angeles")
  startHour Int      @default(20) // 8 PM
  endHour   Int      @default(9) // 9 AM
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId])
  @@map("quiet_hours")
}

// PII Encryption envelopes
model PIIEnvelope {
  id             String   @id @default(cuid())
  accountId      String
  leadId         String?
  propertyId     String?
  fieldName      String // phone, email, ownerName, etc.
  encryptedValue String
  keyVersion     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId])
  @@index([leadId])
  @@index([propertyId])
  @@map("pii_envelopes")
}

// Job queues (BullMQ)
model JobQueue {
  id          String    @id @default(cuid())
  queueName   String
  jobId       String
  status      String // pending, active, completed, failed, delayed
  data        Json?
  result      Json?
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([queueName])
  @@index([status])
  @@index([jobId])
  @@map("job_queues")
}

// Underwriting results
model UnderwritingResult {
  id                 String   @id @default(cuid())
  dealId             String   @unique
  propertyId         String?
  arv                Float?
  repairEstimate     Float?
  mao                Float?
  confidence         Float?
  rationale          String?
  compsSummary       Json?
  evaluationMetadata Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@map("underwriting_results")
}

// Marketing materials
model MarketingMaterial {
  id        String   @id @default(cuid())
  dealId    String
  type      String // flyer, video_script, buyer_blast
  content   String? // text content
  fileUrl   String? // PDF, video URL
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([type])
  @@map("marketing_materials")
}

model JobRun {
  id              String           @id @default(cuid())
  tenantId        String
  kind            JobRunKind
  entityType      JobRunEntityType
  entityId        String
  status          JobRunStatus     @default(QUEUED)
  attempts        Int              @default(0)
  error           String?
  resultJson      Json?
  resultHash      String?
  actorId         String?
  automationRunId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId, kind, entityId])
  @@index([tenantId, status])
  @@index([automationRunId])
  @@map("job_runs")
}

model TimelineEvent {
  id          String             @id @default(cuid())
  tenantId    String
  entityType  TimelineEntityType
  entityId    String
  eventType   String
  payloadJson Json?
  actorId     String?
  actorType   TimelineActorType
  createdAt   DateTime           @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@map("timeline_events")
}

// --- Agent / Automation Integration ---

enum AutomationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  AWAITING_APPROVAL
}

enum AutomationTriggerType {
  MANUAL
  SCHEDULED
  INBOUND_WEBHOOK
  UI
  API
}

model AutomationRun {
  id                 String                @id @default(cuid())
  tenantId           String
  source             String                @default("agent")
  agentName          String?
  workflowName       String?
  entityType         String?
  entityId           String?
  status             AutomationRunStatus   @default(QUEUED)
  startedAt          DateTime?
  completedAt        DateTime?
  triggerType        AutomationTriggerType @default(API)
  inputJson          Json?
  outputJson         Json?
  decisionJson       Json?
  errorJson          Json?
  approvalRequired   Boolean               @default(false)
  approvedByUserId   String?
  approvedAt         DateTime?
  modelProvider      String?
  modelName          String?
  promptVersion      String?
  estimatedValueUsd  Float?
  realizedValueUsd   Float?
  aiCostUsd          Float?                @default(0)
  messageCostUsd     Float?                @default(0)
  toolCostUsd        Float?                @default(0)
  otherCostUsd       Float?                @default(0)
  humanReviewMinutes Float?
  parentRunId        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  parentRun AutomationRun?  @relation("RunHierarchy", fields: [parentRunId], references: [id])
  childRuns AutomationRun[] @relation("RunHierarchy")
  messages  Message[]       @relation("AutomationRunMessages")
  replay    AgentRunReplay?

  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, source, createdAt])
  @@index([tenantId, workflowName, createdAt])
  @@map("automation_runs")
}

/// What an agent saw and what the model answered, for one run. Replays the
/// decision exactly and seeds the agents' golden set (docs/agent-eval.md).
/// Non-contact data only: the worker never holds phone numbers or emails.
model AgentRunReplay {
  runId         String   @id
  tenantId      String
  agent         String
  promptVersion String?
  context       Json
  /// The model's raw reply; null when a rule decided.
  reply         String?  @db.Text
  createdAt     DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, agent, createdAt])
  @@map("agent_run_replays")
}

model DealEconomics {
  id              String    @id @default(cuid())
  dealId          String    @unique
  tenantId        String
  contractPrice   Float?
  assignmentPrice Float?
  assignmentFee   Float?
  purchasePrice   Float?
  salePrice       Float?
  closingCosts    Float?
  marketingCost   Float?
  skipTraceCost   Float?
  smsCost         Float?
  emailCost       Float?
  aiCostAllocated Float?
  toolingCost     Float?
  laborCost       Float?
  otherCost       Float?
  grossRevenue    Float?
  netProfit       Float?
  roiPercent      Float?
  /// projected | realized | lost. grossRevenue/netProfit are projections
  /// until the configured recognition event; realizedFee is money received.
  revenueStatus   String    @default("projected")
  realizedFee     Float?
  realizedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dealId])
  @@map("deal_economics")
}

model AuditLog {
  id        String   @id @default(cuid())
  accountId String
  userId    String?
  action    String
  resource  String
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Cost governance / IntegrationCostControlService
// =============================================================================
// Every paid external call funnels through `IntegrationCostControlService`.
// The service writes one `IntegrationCostEvent` per intent (reserved at
// preflight, finalized in `recordActual`), debits the relevant
// `IntegrationBudgetBucket` rows, and rolls daily totals into
// `IntegrationUsageAggregate` for fast dashboard reads. It is the only cost
// ledger: the former `ai_cost_logs` and `api_cost_logs` were folded into it
// (rows tagged metadata.legacy) and dropped.

model IntegrationProvider {
  id               String   @id @default(cuid())
  key              String   @unique // 'attom' | 'rentcast' | 'openai' | 'twilio' | ...
  displayName      String
  category         String // 'property_data' | 'ai' | 'comms' | 'skip_trace' | 'geocoding' | 'esign'
  enabled          Boolean  @default(true)
  isFallbackFor    String? // provider key this can substitute for
  defaultCostUsd   Float    @default(0)
  rateLimitPerMin  Int?
  concurrencyLimit Int?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pricingRules ProviderPricingRule[]
  costEvents   IntegrationCostEvent[]
  rateLimits   ProviderRateLimit[]

  @@map("integration_providers")
}

model ProviderPricingRule {
  id          String              @id @default(cuid())
  providerId  String
  provider    IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  action      String // matches CostIntent.action
  unitCostUsd Float
  unit        String // 'per_call' | 'per_1k_input_tokens' | 'per_1k_output_tokens' | 'per_record' | 'per_segment'
  pricePer    Float               @default(1)
  effectiveAt DateTime            @default(now())
  expiresAt   DateTime?
  notes       String?

  @@index([providerId, action, effectiveAt])
  @@map("provider_pricing_rules")
}

model ProviderRateLimit {
  id          String              @id @default(cuid())
  providerId  String
  provider    IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  scope       String // 'global' | 'per_account'
  windowSec   Int // 60 = per minute
  maxRequests Int
  enabled     Boolean             @default(true)

  @@unique([providerId, scope, windowSec])
  @@map("provider_rate_limits")
}

model IntegrationBudgetBucket {
  id              String   @id @default(cuid())
  accountId       String // 'GLOBAL' for cross-tenant caps
  scope           String // 'global' | 'provider' | 'workflow' | 'campaign' | 'lead'
  scopeRef        String // provider key, workflow name, campaignId, leadId, or 'ALL'
  period          String // 'day' | 'week' | 'month'
  hardCapUsd      Float
  softCapUsd      Float?
  currentSpendUsd Float    @default(0)
  periodStartedAt DateTime
  periodResetsAt  DateTime
  enabled         Boolean  @default(true)
  notes           String?
  updatedAt       DateTime @updatedAt

  @@unique([accountId, scope, scopeRef, period, periodStartedAt])
  @@index([accountId, periodResetsAt])
  @@index([accountId, scope, scopeRef, period])
  @@map("integration_budget_buckets")
}

model IntegrationCostEvent {
  id               String              @id @default(cuid())
  accountId        String
  providerId       String
  provider         IntegrationProvider @relation(fields: [providerId], references: [id])
  providerKey      String // denormalized for fast group-by
  action           String
  reservationId    String              @unique
  estimatedCostUsd Float
  actualCostUsd    Float?
  status           String // 'reserved' | 'completed' | 'errored' | 'cancelled' | 'cache_hit'
  decision         String // CostDecision.kind
  durationMs       Int?
  responseCode     Int?
  retryCount       Int                 @default(0)
  leadId           String?
  propertyId       String?
  dealId           String?
  campaignId       String?
  automationRunId  String?
  actor            String // 'user' | 'system' | 'worker'
  userId           String?
  metadata         Json?
  bucketIds        String[] // budget buckets debited
  idempotencyKey   String?
  createdAt        DateTime            @default(now())
  completedAt      DateTime?

  @@index([accountId, createdAt])
  @@index([accountId, providerKey, createdAt])
  @@index([accountId, leadId])
  @@index([accountId, automationRunId])
  @@index([idempotencyKey, createdAt])
  @@map("integration_cost_events")
}

model IntegrationUsageAggregate {
  id           String   @id @default(cuid())
  accountId    String
  providerKey  String
  action       String
  period       String // 'day' | 'month'
  periodKey    String // '2026-05-02' | '2026-05'
  callCount    Int      @default(0)
  totalCostUsd Float    @default(0)
  cacheHits    Int      @default(0)
  errors       Int      @default(0)
  rateLimited  Int      @default(0)
  costSavedUsd Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([accountId, providerKey, action, period, periodKey])
  @@index([accountId, period, periodKey])
  @@map("integration_usage_aggregates")
}

model IntegrationFeatureFlag {
  id        String    @id @default(cuid())
  accountId String // 'GLOBAL' for org-wide defaults
  flag      String // e.g. 'provider.realie', 'provider.openai'
  enabled   Boolean   @default(false)
  reason    String?
  enabledAt DateTime?
  expiresAt DateTime?
  updatedBy String?
  updatedAt DateTime  @updatedAt

  @@unique([accountId, flag])
  @@index([accountId, enabled])
  @@map("integration_feature_flags")
}

model ManualBudgetOverride {
  id             String   @id @default(cuid())
  accountId      String
  scope          String // 'lead' | 'campaign' | 'workflow'
  scopeRef       String
  reason         String
  approvedBy     String // userId
  extraBudgetUsd Float
  expiresAt      DateTime
  consumed       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([accountId, scope, scopeRef, expiresAt])
  @@map("manual_budget_overrides")
}

model CachedProviderResponse {
  id           String   @id @default(cuid())
  accountId    String
  providerKey  String
  cacheKey     String // sha256(provider + action + canonical(payload))
  payload      Json
  responseCode Int?
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime
  hitCount     Int      @default(0)
  costSavedUsd Float    @default(0)

  @@unique([accountId, providerKey, cacheKey])
  @@index([accountId, providerKey, expiresAt])
  @@map("cached_provider_responses")
}

model LeadEnrichmentJob {
  id             String    @id @default(cuid())
  accountId      String
  leadId         String
  stage          String // 'queued' | 'normalizing' | 'cheap_filters' | 'attom' | 'rentcast' | 'scoring' | 'skip_trace' | 'completed' | 'rejected'
  rejectedReason String?
  totalCostUsd   Float     @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  metadata       Json?

  @@index([accountId, stage])
  @@index([leadId])
  @@map("lead_enrichment_jobs")
}

/// A target market the sourcing scheduler pulls leads for on a cadence
/// (docs/sourcing-markets.md). One row per area per tenant; `sources` are
/// listing-source keys (mls | rentcast | realie), `criteria` the per-source
/// filters, `lastResult` the outcome of the latest pull.
model SourcingMarket {
  id         String    @id @default(cuid())
  accountId  String
  label      String
  state      String
  city       String?
  postalCode String?
  sources    String[]
  criteria   Json?
  cadence    String    @default("daily") // daily | weekly | manual
  enabled    Boolean   @default(true)
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  lastResult Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([accountId, label])
  @@index([enabled, nextRunAt])
  @@index([accountId, createdAt])
  @@map("sourcing_markets")
}

/// A file in the tenant's document library: agreement templates, signed
/// contracts, disclosures, compliance records, closing paperwork. Bytes live
/// in object storage under `storageKey`; this row carries the metadata and
/// links to a deal, lead or buyer. See docs/documents-and-compliance.md.
model Document {
  id           String   @id @default(cuid())
  accountId    String
  category     String // agreement_template | contract | disclosure | compliance | closing | marketing | other
  title        String
  description  String?
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  dealId       String?
  leadId       String?
  buyerId      String?
  jurisdiction String? // two-letter state the document is specific to, if any
  status       String   @default("active") // active | archived
  tags         String[]
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId, category, createdAt])
  @@index([accountId, dealId])
  @@index([accountId, status])
  @@map("documents")
}

// =============================================================================
// Contract flipping (docs/contract-flipping.md)
// =============================================================================
// The seller contract Halo holds, the state rules that apply to it, the
// buyers it is offered to and their offers, and the closing that turns an
// accepted offer into a collected fee. Halo owns every one of these rows:
// agents read them through the api and change them only through its
// services, and every binding step waits for a person.

/// The acquisition contract with the seller: the terms Halo relies on to
/// market and assign the deal, and a person's verification of them against
/// the executed copy. A deal is marketed only from an executed, verified,
/// assignable agreement (packages/shared disposition/eligibility.ts).
model PurchaseAgreement {
  id                      String    @id @default(cuid())
  accountId               String
  dealId                  String
  /// draft | sent | executed | terminated | expired
  status                  String    @default("draft")
  /// The DocuSign envelope it went out in, when it did.
  contractId              String?   @unique
  /// The executed copy in the documents library.
  executedDocumentId      String?
  jurisdiction            String?
  purchasePrice           Float?
  earnestMoneyAmount      Float?
  earnestMoneyDueAt       DateTime?
  earnestMoneyDepositedAt DateTime?
  inspectionEndsAt        DateTime?
  closingDeadline         DateTime?
  executedAt              DateTime?
  /// permitted | consent_required | prohibited | unknown. Unknown is never permission.
  assignability           String    @default("unknown")
  /// The clause, or where it is (e.g. "s.14, p.6").
  assignmentClause        String?
  sellerConsentDocumentId String?
  /// The seller was told in writing that we may assign.
  sellerAssignmentNotice  Boolean   @default(false)
  verifiedAt              DateTime?
  verifiedBy              String?
  /// Each verification key a person confirmed, with when.
  verification            Json?
  terminatedAt            DateTime?
  terminationReason       String?
  notes                   String?
  createdBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([dealId])
  @@index([accountId, closingDeadline])
  @@map("purchase_agreements")
}

// =============================================================================
// Markets (docs/markets.md)
// =============================================================================
// One market per jurisdiction per tenant. Research and counsel's answers
// live in a draft; the gates rely only on the last version counsel
// approved, which is never edited. A person sets how far a market may
// operate, and Halo refuses any status the approved policy and the
// requirements on file do not support.

/// A jurisdiction Halo may operate in, for one tenant.
model Market {
  id                 String    @id @default(cuid())
  accountId          String
  /// Two-letter code: the 50 states and DC.
  state              String
  /// The draft's proposed classification: unclassified | A | B | C | D | E.
  classification     String    @default("unclassified")
  /// MarketPolicyContent (packages/shared markets/policy.ts): research and answers, unreviewed.
  draft              Json
  /// draft | in_review
  draftStatus        String    @default("draft")
  draftUpdatedAt     DateTime?
  draftUpdatedBy     String?
  submittedAt        DateTime?
  submittedBy        String?
  /// When bundled research was last imported into the draft, and its date.
  researchImportedAt DateTime?
  researchDate       String?
  researchConfidence String?
  /// The policy version the gates rely on.
  approvedVersionId  String?
  /// What a person asked for (ACTIVATION_STATUSES). The effective status is
  /// the lower of this and what the approved policy and requirements allow.
  requestedStatus    String    @default("RESEARCH_ONLY")
  statusNote         String?
  statusSetBy        String?
  statusSetAt        DateTime?
  /// The person responsible for operations in the market.
  operatorUserId     String?
  operatorName       String?
  selfTestAt         DateTime?
  selfTestPassed     Boolean?
  selfTestResult     Json?
  /// Set whenever the policy, a template or an authorization changes; a
  /// self-test older than this is stale.
  configChangedAt    DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([accountId, state])
  @@map("markets")
}

/// An approved policy: a snapshot of the draft as counsel approved it.
/// Never updated except to record when a later version superseded it.
model MarketPolicyVersion {
  id              String    @id @default(cuid())
  accountId       String
  state           String
  version         Int
  classification  String
  content         Json
  approvedBy      String
  approvedAt      DateTime  @default(now())
  counselName     String
  counselFirm     String?
  /// Counsel's memo or approval letter, in the documents library.
  memoDocumentId  String
  /// The statement the approver confirmed.
  attestation     String
  reviewExpiresAt DateTime?
  supersededAt    DateTime?
  createdAt       DateTime  @default(now())

  @@unique([accountId, state, version])
  @@index([accountId, state])
  @@map("market_policy_versions")
}

/// A licence, registration or partner agreement a market requires.
model MarketAuthorization {
  id           String    @id @default(cuid())
  accountId    String
  state        String
  /// AUTHORIZATION_KINDS
  kind         String
  holderName   String
  /// company | operator | broker_partner
  holderType   String    @default("company")
  holderUserId String?
  /// Licence or registration number.
  identifier   String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  documentId   String?
  /// pending | active | expired | revoked
  status       String    @default("pending")
  verifiedAt   DateTime?
  verifiedBy   String?
  notes        String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([accountId, state])
  @@map("market_authorizations")
}

/// A reusable document: purchase and assignment agreements, disclosures,
/// notices. The text is counsel's; Halo fills merge fields.
model DocumentTemplate {
  id            String    @id @default(cuid())
  accountId     String
  /// TEMPLATE_KINDS
  kind          String
  name          String
  description   String?
  /// For a disclosure template: the policy disclosure key it produces.
  disclosureKey String?
  createdBy     String?
  retiredAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  versions DocumentTemplateVersion[]

  @@index([accountId, kind])
  @@map("document_templates")
}

/// One uploaded revision of a template. Its file and fields never change;
/// a new upload is a new version. Only an approved version generates
/// documents, and only in the jurisdictions it was approved for.
model DocumentTemplateVersion {
  id                 String           @id @default(cuid())
  accountId          String
  templateId         String
  template           DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version            Int
  /// The source file in the documents library.
  documentId         String
  /// docx | txt
  format             String
  sha256             String
  /// Merge fields the file uses, and any the registry does not know.
  fields             String[]
  unknownFields      String[]
  /// Fields every template of this kind must contain that this one lacks.
  missingRequired    String[]
  /// Jurisdiction codes it applies to; "ALL" for every jurisdiction.
  states             String[]
  /// draft | validated | approved | retired
  status             String           @default("draft")
  counselName        String?
  counselFirm        String?
  approvalDocumentId String?
  attestation        String?
  approvedBy         String?
  approvedAt         DateTime?
  retiredAt          DateTime?
  notes              String?
  createdBy          String?
  createdAt          DateTime         @default(now())

  @@unique([templateId, version])
  @@index([accountId, status])
  @@map("document_template_versions")
}

/// A document Halo filled from an approved template: what went in, what
/// came out, and where it went. Lets a signed copy be traced to its source.
model DocumentGeneration {
  id                String   @id @default(cuid())
  accountId         String
  dealId            String?
  templateVersionId String
  kind              String
  state             String?
  /// The merge values used, as filled.
  values            Json
  documentId        String
  pdfDocumentId     String?
  sha256            String
  /// draft | sent | executed | void
  status            String   @default("draft")
  envelopeId        String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId, dealId])
  @@map("document_generations")
}

/// A purchase a buyer made, with where we learned of it. Public-record and
/// Halo closings are evidence; buyer-provided and manual rows are claims.
model BuyerTransaction {
  id           String    @id @default(cuid())
  accountId    String
  buyerId      String
  address      String?
  city         String?
  state        String?
  zip          String?
  propertyType String?
  price        Float?
  closedAt     DateTime?
  /// public_record | buyer_provided | halo_closing | manual
  source       String
  sourceRef    String?
  dealId       String?
  createdBy    String?
  createdAt    DateTime  @default(now())

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([accountId, state, city])
  @@index([accountId, zip])
  @@index([buyerId])
  @@map("buyer_transactions")
}

/// The buyer-facing investment package for a deal, versioned. Built from a
/// whitelist of buyer-safe facts: never the contract price, the offer to the
/// seller or the MAO. Only an approved version is shown to buyers.
model DealPackage {
  id          String    @id @default(cuid())
  accountId   String
  dealId      String
  version     Int
  /// draft | approved | superseded
  status      String    @default("draft")
  content     Json
  askingPrice Float
  approvedBy  String?
  approvedAt  DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deal       Deal                  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  campaigns  DispositionCampaign[]
  shareLinks DealShareLink[]

  @@unique([dealId, version])
  @@index([accountId, status])
  @@map("deal_packages")
}

/// Offering one contract to selected buyers: the price, the package, the
/// outreach a person approved, and who was offered it.
model DispositionCampaign {
  id              String    @id @default(cuid())
  accountId       String
  dealId          String
  packageId       String?
  /// draft | active | paused | completed | cancelled | expired
  status          String    @default("draft")
  askingPrice     Float
  floorPrice      Float
  /// The pricing recommendation it was built on (fee-pricing.ts).
  pricing         Json?
  channel         String    @default("email")
  outreachSubject String
  outreachBody    String
  followUpDays    Int       @default(3)
  maxFollowUps    Int       @default(2)
  approvedBy      String?
  approvedAt      DateTime?
  launchedAt      DateTime?
  expiresAt       DateTime?
  endedAt         DateTime?
  endedReason     String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deal    Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  package DealPackage?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  targets DispositionTarget[]
  offers  BuyerOffer[]

  @@index([accountId, status])
  @@index([dealId])
  @@map("disposition_campaigns")
}

/// One buyer in a campaign: why they were chosen and what happened.
model DispositionTarget {
  id             String    @id @default(cuid())
  accountId      String
  campaignId     String
  buyerId        String
  rank           Int
  score          Float
  /// The deterministic match: components, evidence, explanation.
  match          Json
  /// selected | contacted | viewed | interested | offered | declined | opted_out | skipped
  status         String    @default("selected")
  shareLinkId    String?
  lastMessageId  String?
  contactedAt    DateTime?
  lastActivityAt DateTime?
  followUps      Int       @default(0)
  skipReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign DispositionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  buyer    Buyer               @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, buyerId])
  @@index([accountId, status])
  @@map("disposition_targets")
}

/// A token-gated buyer page for one deal package. Only the hash of the token
/// is stored; the link works until it expires, is revoked, or the deal stops
/// being eligible.
model DealShareLink {
  id            String    @id @default(cuid())
  accountId     String
  dealId        String
  packageId     String
  campaignId    String?
  buyerId       String?
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedBy     String?
  viewCount     Int       @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  deal    Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  package DealPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([accountId, dealId])
  @@index([buyerId])
  @@map("deal_share_links")
}

/// What a buyer offered for the contract. `amount` is their total price for
/// the assignment. An offer read out of an email by an agent is captured as
/// such and must be confirmed by a person before it can be accepted.
model BuyerOffer {
  id                String    @id @default(cuid())
  accountId         String
  dealId            String
  buyerId           String
  campaignId        String?
  /// indication | written_offer
  kind              String    @default("written_offer")
  /// email | sms | deal_page | phone | manual
  source            String
  sourceMessageId   String?
  /// person | buyer | agent: who put the number into Halo.
  capturedBy        String
  captureConfidence Float?
  confirmedAt       DateTime?
  confirmedBy       String?
  amount            Float
  earnestMoney      Float?
  closeBy           DateTime?
  financing         String?
  conditions        String?
  pofProvided       Boolean   @default(false)
  /// received | countered | accepted | rejected | withdrawn | expired | superseded
  status            String    @default("received")
  counterAmount     Float?
  counteredAt       DateTime?
  counteredBy       String?
  decidedAt         DateTime?
  decidedBy         String?
  decisionReason    String?
  /// The pricing evaluation at the last decision (fee-pricing.ts).
  evaluation        Json?
  expiresAt         DateTime?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  deal       Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  buyer      Buyer                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  campaign   DispositionCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignment AssignmentAgreement?

  @@index([accountId, dealId, status])
  @@index([buyerId])
  @@map("buyer_offers")
}

/// The transfer of our position to the buyer, at the terms a person approved.
/// For a double close the same row records the resale (B-C) contract.
model AssignmentAgreement {
  id                     String    @id @default(cuid())
  accountId              String
  dealId                 String
  buyerId                String
  offerId                String?   @unique
  purchaseAgreementId    String
  /// assignment | double_close
  structure              String    @default("assignment")
  /// draft | sent | executed | cancelled
  status                 String    @default("draft")
  assignmentPrice        Float
  assignmentFee          Float
  buyerDepositAmount     Float?
  buyerDepositDueAt      DateTime?
  buyerDepositReceivedAt DateTime?
  contractId             String?   @unique
  executedDocumentId     String?
  executedAt             DateTime?
  approvedBy             String
  approvedAt             DateTime
  cancelledAt            DateTime?
  cancelledBy            String?
  cancellationReason     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  deal  Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  offer BuyerOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([accountId, status])
  @@index([dealId])
  @@map("assignment_agreements")
}

/// Title and closing coordination for a deal, opened when the seller
/// contract is executed. The fee is projected until a person records the
/// closing (and, by default, the money received).
model ClosingFile {
  id                   String    @id @default(cuid())
  accountId            String
  dealId               String    @unique
  /// assignment | double_close
  structure            String    @default("assignment")
  /// open | clear_to_close | closed | cancelled
  status               String    @default("open")
  /// not_opened | opened | commitment_received | clear | issues
  titleStatus          String    @default("not_opened")
  /// The title company or closing attorney: a business contact.
  closingAgentCompany  String?
  closingAgentOfficer  String?
  closingAgentEmail    String?
  closingAgentPhone    String?
  fileNumber           String?
  scheduledClosingAt   DateTime?
  closedAt             DateTime?
  closedBy             String?
  settlementDocumentId String?
  expectedFee          Float?
  realizedFee          Float?
  feeReceivedAt        DateTime?
  feeRecordedBy        String?
  revenueRecognizedAt  DateTime?
  cancelledAt          DateTime?
  cancelledBy          String?
  cancellationReason   String?
  openedAt             DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  deal       Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  milestones ClosingMilestone[]
  issues     ClosingIssue[]

  @@index([accountId, status])
  @@map("closing_files")
}

model ClosingMilestone {
  id                 String    @id @default(cuid())
  accountId          String
  closingFileId      String
  key                String
  label              String
  blocking           Boolean   @default(true)
  /// pending | done | waived
  status             String    @default("pending")
  dueAt              DateTime?
  completedAt        DateTime?
  completedBy        String?
  note               String?
  evidenceDocumentId String?
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  closingFile ClosingFile @relation(fields: [closingFileId], references: [id], onDelete: Cascade)

  @@unique([closingFileId, key])
  @@index([accountId, status, dueAt])
  @@map("closing_milestones")
}

/// Something that can stop the closing: a lien, a missing signature, a
/// buyer who cannot fund. A blocking issue also blocks disposition.
model ClosingIssue {
  id            String    @id @default(cuid())
  accountId     String
  closingFileId String
  dealId        String
  /// title | funding | signature | contingency | deadline | other
  kind          String
  /// blocking | warning
  severity      String    @default("blocking")
  description   String
  /// open | resolved
  status        String    @default("open")
  raisedBy      String?
  resolvedAt    DateTime?
  resolvedBy    String?
  resolution    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  closingFile ClosingFile @relation(fields: [closingFileId], references: [id], onDelete: Cascade)

  @@index([accountId, dealId, status])
  @@map("closing_issues")
}

/// What a tax sale actually conveyed (docs/contract-flipping.md s4). The
/// advertised price is not a purchasable interest: a lien certificate is not
/// ownership, a bid is nothing until confirmed, and an owner can redeem.
model TaxSaleInterest {
  id                 String    @id @default(cuid())
  accountId          String
  dealId             String    @unique
  /// tax_deed | tax_lien_certificate | auction_bid | unknown
  interestType       String    @default("unknown")
  county             String?
  auctionDate        DateTime?
  advertisedPrice    Float?
  winningBid         Float?
  redemptionEndsAt   DateTime?
  redeemed           Boolean   @default(false)
  /// unverified | clouded | quiet_title_needed | insurable
  titleStatus        String    @default("unverified")
  /// yes | no | unknown
  transferable       String    @default("unknown")
  /// Deed, certificate or county record in the documents library.
  evidenceDocumentId String?
  verifiedAt         DateTime?
  verifiedBy         String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("tax_sale_interests")
}

// =============================================================================
// Property data and buyer discovery (docs/data-pipeline.md)
// =============================================================================

/// A recorded sale, from any provider, in one shape. Public-record facts:
/// who bought, from whom, when, for how much, with or without a mortgage.
model RecordedSale {
  id              String   @id @default(cuid())
  accountId       String
  /// attom | regrid | county_csv | ...
  source          String
  sourceRef       String
  state           String
  county          String?
  countyFips      String?
  city            String?
  zip             String?
  address         String?
  apn             String?
  saleDate        DateTime
  price           Float?
  buyerName       String?
  buyerKind       String?
  buyerKey        String?
  buyerMailingZip String?
  sellerName      String?
  sellerKind      String?
  sellerKey       String?
  cashPurchase    Boolean?
  armsLength      Boolean?
  deedType        String?
  propertyType    String?
  /// recorded | reported | estimated
  quality         String   @default("recorded")
  importId        String?
  createdAt       DateTime @default(now())

  @@unique([accountId, source, sourceRef])
  @@index([accountId, state, saleDate])
  @@index([accountId, buyerKey])
  @@index([accountId, countyFips])
  @@index([accountId, zip])
  @@map("recorded_sales")
}

/// A batch of records brought in from a file or a provider pull.
model DataImport {
  id         String   @id @default(cuid())
  accountId  String
  /// recorded_sales | parcels
  kind       String
  source     String
  documentId String?
  state      String?
  county     String?
  /// Column mapping or request parameters used.
  params     Json?
  rows       Int      @default(0)
  imported   Int      @default(0)
  skipped    Int      @default(0)
  errors     Json?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("data_imports")
}

/// A likely cash buyer found in recorded sales: evidence of what they
/// bought, and the buy box Halo infers from it. Not a buyer until a person
/// promotes them, and not contactable until contact and consent are on file.
model BuyerCandidate {
  id                String   @id @default(cuid())
  accountId         String
  key               String
  name              String
  /// company | trust | individual
  kind              String
  mailingZip        String?
  purchaseCount     Int
  cashPurchases     Int
  financedPurchases Int
  resales           Int
  medianHoldDays    Float?
  firstPurchase     DateTime
  lastPurchase      DateTime
  states            String[]
  buyBox            Json
  purchases         Json
  score             Int
  reasons           String[]
  /// candidate | promoted | dismissed
  status            String   @default("candidate")
  buyerId           String?
  dismissedReason   String?
  refreshedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([accountId, key])
  @@index([accountId, status, score])
  @@map("buyer_candidates")
}

/// What an email or SMS provider reported about a message after it left:
/// delivered, bounced, complained, unsubscribed, opened. One row per
/// provider event; the provider's event id makes webhook retries no-ops.
model MessageEvent {
  id              String   @id @default(cuid())
  accountId       String
  messageId       String?
  /// sendgrid | resend | twilio
  provider        String
  /// delivered | bounce | dropped | deferred | complaint | unsubscribe | open | click | processed
  event           String
  /// hard | soft, for bounces
  bounceType      String?
  reason          String?
  providerEventId String
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([accountId, occurredAt])
  @@index([messageId])
  @@map("message_events")
}
