# ── Core ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://halo:halo_dev_password@localhost:5432/halo_dev?schema=public"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"

# ── AI / LLM ─────────────────────────────────────────────────────
# The worker holds no model keys; it names a model and the api routes it.
# AI_MODEL may be an OpenAI (gpt-*) or Anthropic (claude-*) model.
AI_MODEL=gpt-4o
OPENAI_DAILY_COST_CAP=5

# ── External Data Integrations ───────────────────────────────────

# ── Twilio (SMS) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Email ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
USE_SENDGRID="false"
SMTP_HOST="localhost"
SMTP_PORT=1025


# ── Health Probe ─────────────────────────────────────────────────
WORKER_HEALTH_PORT=3002
