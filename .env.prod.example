# Production environment for docker-compose.prod.yml. Copy to .env on the
# server; scripts/deploy/bootstrap.sh fills the generated secrets. Never
# commit .env. Provider keys are better entered on Admin -> Integrations
# (encrypted at rest); the values here are only the fallback.

# ---- Domains ---------------------------------------------------------------
# Also replace the three hostnames in Caddyfile.
PUBLIC_API_URL=https://api.example.com/api
# The web app origin: buyer deal pages are links to <PUBLIC_APP_URL>/p/deals/<token>
PUBLIC_APP_URL=https://app.example.com
# The legal entity that signs purchase agreements and assignments ({{buyer_entity}} in templates)
HALO_CONTRACTING_ENTITY=
# Word-to-PDF for generated documents: a Gotenberg service (docs/markets.md s6).
# Without it, Word templates generate .docx only; text templates still get PDFs.
PDF_CONVERTER_URL=http://gotenberg:3000
# Regrid parcels (docs/data-pipeline.md); also settable on the Integrations page.
REGRID_API_TOKEN=
NEXT_PUBLIC_API_URL=https://api.example.com/api
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=1

# ---- Auth (Descope) --------------------------------------------------------
# Production: tokens managed in cookies on the parent domain
# (docs/deployment-runbook.md, "Descope in production").
DESCOPE_PROJECT_ID=
DESCOPE_MANAGEMENT_KEY=
# The custom domain, e.g. https://auth.example.com
DESCOPE_BASE_URL=
NEXT_PUBLIC_DESCOPE_FLOW_ID=sign-in
# Only if the session cookie was renamed in Descope (default DS).
DESCOPE_SESSION_COOKIE=

# ---- Generated secrets (bootstrap.sh fills empty ones; keep them in your password manager)
POSTGRES_USER=halo
POSTGRES_DB=halo_prod
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=halo
MINIO_ROOT_PASSWORD=
# Encrypts provider keys saved on the Integrations page.
SECRETS_ENCRYPTION_KEY=
# Envelope-encrypt every phone and email. Losing these loses the contacts.
PII_ENCRYPTION_KEY_V1=
PII_ENCRYPTION_KEY_CURRENT_VERSION=1
PII_INDEX_KEY=
# Worker -> api service token. /api/internal is never exposed by Caddy.
INTERNAL_API_TOKEN=

# ---- Object storage (RustFS in compose; any S3 works) ----------------------
S3_ENDPOINT=http://minio:9000
S3_BUCKET=halo-documents
S3_REGION=us-east-1

# ---- Messaging -------------------------------------------------------------
MESSAGING_BRAND_NAME=Halo Acquisitions
MESSAGING_HELP_CONTACT=support@example.com
# A display name with parentheses must be quoted, or it is read as a comment
# and dropped: "Halo (Texas)" <deals@example.com>
EMAIL_FROM=deals@example.com
# Replies: a mailbox on the SendGrid Inbound Parse subdomain (docs/integrations/email-inbound.md)
EMAIL_REPLY_TO=deals@reply.example.com
# Token in the Inbound Parse URL; usually saved on the Integrations page as SENDGRID_INBOUND_TOKEN
INBOUND_EMAIL_TOKEN=
# Delivery events (docs/communications.md s5): the SendGrid Event Webhook's
# verification key, or the Resend webhook signing secret (whsec_...)
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
RESEND_WEBHOOK_SECRET=
# Comma-separated addresses that may receive a test send (exact matches only)
EMAIL_INTERNAL_RECIPIENTS=
EMAIL_POSTAL_ADDRESS=123 Main St, Suite 100, Austin, TX 78701
USE_SENDGRID=true
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=deals@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMS_KEYWORD_REPLIES=on
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- AI --------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_DAILY_COST_CAP=5
AI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# ---- Property data ---------------------------------------------------------
ATTOM_API_KEY=
ATTOM_BASE_URL=https://api.gateway.attomdata.com
RENTCAST_API_KEY=
REALIE_API_KEY=
GOOGLE_GEOCODING_API_KEY=
SKIP_TRACE_PROVIDER=batch
BATCH_SKIPTRACE_API_KEY=
MLS_PROVIDER=
MLS_BASE_URL=
MLS_API_TOKEN=
MLS_USERNAME=
MLS_PASSWORD=
MLS_DATASET=

# ---- Contracts (DocuSign JWT grant; docs/integrations/docusign.md) ---------
DOCUSIGN_ENV=demo
DOCUSIGN_CLIENT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_BASE_URL=
DOCUSIGN_CONNECT_SECRET=

# ---- Schedulers and agents (docs/agent-design.md, docs/sourcing-markets.md)
SOURCING_SCHEDULER=on
# New leads enriched automatically; the daily cap is set on Leads > Markets
AUTO_ENRICH=on
SOURCING_RUN_HOUR_UTC=6
AGENT_SWEEP=on
AGENT_SWEEP_HOUR_UTC=7
AGENT_SWEEP_STALE_DAYS=7
AGENT_FOLLOWUP_DAYS=3
AGENT_FOLLOWUP_MAX=3
OUTREACH_STRONG_TIER_MIN_ARV=400000
AGENT_MATCHER_CANDIDATES=15
AGENT_MATCHER_SHORTLIST_MAX=10
# Contract flipping (docs/contract-flipping.md): hourly campaign expiry, offer
# expiry and closing alerts; buyer follow-up drafts once a day at this hour
DISPOSITION_SWEEP=on
DISPOSITION_SWEEP_HOUR_UTC=13

# ---- Alerts (docs/deployment-runbook.md section 5) ------------------------
# Slack, Discord or Teams incoming webhook. The api posts unexpected errors,
# failed jobs and budget caps here; scripts/deploy/healthwatch.sh posts
# downtime and recovery.
ALERT_WEBHOOK_URL=

# ---- Backups (scripts/deploy/backup.sh, deploy.sh) ------------------------
BACKUP_DIR=/var/backups/halo
BACKUP_KEEP_DAYS=14
# Optional: s3://bucket/prefix copied with the aws CLI after each backup.
BACKUP_S3_URI=
# deploy.sh takes a backup before migrating unless this is 0.
BACKUP_BEFORE_DEPLOY=1
